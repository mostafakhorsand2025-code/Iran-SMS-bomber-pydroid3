# ---------------------------------------------------------------- توابع کمکی
def normalize(raw):
    """ورودی 9123456789 یا 09123456789 یا +98912... → 9123456789"""
    d = "".join(c for c in str(raw) if c.isdigit())
    if d.startswith("0098"):
        d = d[4:]
    elif len(d) == 12 and d.startswith("98"):
        d = d[2:]
    d = d.lstrip("0")
    if len(d) != 10 or not d.startswith("9"):
        raise ValueError("شماره باید 10 رقم و با 9 شروع شود (مثال: 9123456789)")
    return d


def make_phones(bare):
    return {
        "bare": bare,
        "local": "0" + bare,
        "intl": "+98" + bare,
        "nocc": "98" + bare,
    }


def fill(obj, ph):
    if isinstance(obj, dict):
        return {k: fill(v, ph) for k, v in obj.items()}
    if isinstance(obj, list):
        return [fill(v, ph) for v in obj]
    if isinstance(obj, str):
        return obj.format(**ph)
    return obj


def send_one(ep, ph, stop):
    if stop.is_set():
        return ep["name"], None, False
    url = ep["url"].format(**ph)
    headers = dict(BASE_HEADERS)
    headers["User-Agent"] = random.choice(UA)
    headers.update(ep.get("headers", {}))

    kwargs = {"headers": headers, "timeout": TIMEOUT}
    if "json" in ep:
        kwargs["json"] = fill(ep["json"], ph)
    if "data" in ep:
        kwargs["data"] = fill(ep["data"], ph)
    if "params" in ep:
        kwargs["params"] = fill(ep["params"], ph)

    try:
        r = requests.request(ep.get("method", "POST"), url, **kwargs)
        ok = r.status_code in (200, 201, 202, 204)
        return ep["name"], r.status_code, ok
    except Exception as e:
        return ep["name"], type(e).__name__, False


def main():
    raw = sys.argv[1] if len(sys.argv) > 1 else input("شماره هدف (مثال 9123456789): ")
    bare = normalize(raw)

    rounds = sys.argv[2] if len(sys.argv) > 2 else input("چند دور ارسال؟ (هر دور ~40 پیامک): ")
    rounds = max(1, int(rounds))

    workers = sys.argv[3] if len(sys.argv) > 3 else input("تعداد ترد همزمان (پیشنهاد 20): ")
    workers = max(1, min(int(workers), len(ENDPOINTS)))

    delay_in = input("فاصله بین دورها به ثانیه (پیشنهاد 2): ").strip() or "2"
    delay = float(delay_in)

    ph = make_phones(bare)
    stop = threading.Event()
    total_ok = 0

    print("\nهدف: {}  |  دورها: {}  |  ترد: {}  |  اندپوینت: {}".format(
        ph["local"], rounds, workers, len(ENDPOINTS)))
    print("-" * 46)

    t0 = time.time()
    try:
        with ThreadPoolExecutor(max_workers=workers) as pool:
            for rd in range(1, rounds + 1):
                futures = [pool.submit(send_one, ep, ph, stop) for ep in ENDPOINTS]
                ok = 0
                failed = []
                for f in as_completed(futures):
                    name, code, success = f.result()
                    if success:
                        ok += 1
                    else:
                        failed.append("{}({})".format(name, code))
                total_ok += ok
                print("[دور {}/{}] موفق: {} از {} | مجموع: {}".format(
                    rd, rounds, ok, len(ENDPOINTS), total_ok))
                if failed:
                    print("   رد شده: " + ", ".join(failed))
                if rd < rounds:
                    time.sleep(delay)
    except KeyboardInterrupt:
        stop.set()
        print("\nمتوقف شد.")

    print("-" * 46)
    print("پایان. کل درخواست موفق: {} در {:.1f} ثانیه".format(total_ok, time.time() - t0))
    print("اگر بعضی سرویس‌ها پیامک ندادن، معمولاً rate-limit یا تغییر API است.")


if __name__ == "__main__":
    main()
